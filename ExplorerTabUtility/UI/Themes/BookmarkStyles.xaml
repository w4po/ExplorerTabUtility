<ResourceDictionary x:Class="ExplorerTabUtility.UI.Themes.BookmarkStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:language="clr-namespace:ExplorerTabUtility.Languages.Manager"
                    xmlns:managers="clr-namespace:ExplorerTabUtility.Managers"
                    xmlns:models="clr-namespace:ExplorerTabUtility.Models"
                    xmlns:behaviors="clr-namespace:ExplorerTabUtility.UI.Behaviors"
                    xmlns:converters="clr-namespace:ExplorerTabUtility.UI.Converters"
                    xmlns:controls="clr-namespace:ExplorerTabUtility.UI.Views.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ExplorerTabUtility;component/UI/Themes/ComboBoxStyles.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/ExplorerTabUtility;component/UI/Themes/TextBoxStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:LevelToThicknessConverter x:Key="LevelToThicknessConverter"/>

    <!--#region 窗体样式 -->
    <!-- BaseBookmarkWindow Style -->
    <Style x:Key="BaseBookmarkWindowStyle" TargetType="controls:BaseBookmarkWindow">
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="SizeToContent" Value="Height"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="Topmost" Value="True"/>
    </Style>
    <!--#endregion-->

    <!--#region Border样式 -->
    <!-- BaseBookmarkWindow Border Style -->
    <Style x:Key="BaseBookmarkWindowBorderStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderGradientBrush}"/>
        <Setter Property="Background" Value="{StaticResource BackgroundGradientBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource ShadowColor}"
                              Direction="270"
                              ShadowDepth="5"
                              BlurRadius="15"
                              Opacity="0.4"/>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region TextBlock样式 -->
    <!-- Bookmark Normal TextBlock Style-->
    <Style x:Key="BookmarkTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Bookmark Header TextBlock Style-->
    <Style x:Key="BookmarkHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BookmarkTextBlockStyle}">
        <Setter Property="Margin" Value="4 0 0 10"/>
    </Style>

    <!-- Bookmark Title TextBlock Style-->
    <Style x:Key="BookmarkTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BookmarkHeaderTextBlockStyle}">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <!-- Bookmark Manage Menu TextBlock Style-->
    <Style x:Key="BookmarkManageMenuTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BookmarkTitleTextBlockStyle}">
        <Setter Property="behaviors:BookmarkHelper.OpenContentMenuOnLeftClick" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <!-- Bookmark ListBoxItem Icon Style -->
    <Style x:Key="BookmarkListBoxItemIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0 0 10 0"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Bookmark ListBoxItem Location Style-->
    <Style x:Key="BookmarkListBoxItemNameStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <!--Bookmark ListBoxItem Location Style-->
    <Style x:Key="BookmarkListBoxItemLocationStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BookmarkListBoxItemNameStyle}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Margin" Value="10 2 0 2"/>
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!--BookmarkMenu Icon Style-->
    <Style x:Key="BookmarkMenuIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--BookmarkMenu Display Style-->
    <Style x:Key="BookmarkMenuDisplayStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <!--Bookmark TreeView Icon Style-->
    <Style x:Key="BookmarkTreeViewIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Bookmark TreeView Display Style-->
    <Style x:Key="BookmarkTreeViewDisplayStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <!--#endregion-->

    <!--#region TextBox样式 -->
    <!-- Bookmark Search TextBox Style -->
    <Style x:Key="BookmarkSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CustomTextBoxStyle}">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!--Bookmark TreeView Edit Style-->
    <Style x:Key="BookmarkTreeViewEditStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource CustomTextBoxStyle}">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="6,4,6,3"/>
    </Style>
    <!--#endregion-->

    <!--#region Button样式 -->
    <!-- BookmarkButton Style-->
    <Style x:Key="BookmarkButtonStyle" TargetType="ButtonBase">
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="Margin" Value="10 15 10 15"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="10 4 10 6"
                            CornerRadius="4">
                        <ContentPresenter x:Name="Main" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="RenderTransform" TargetName="Main">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bookmark ComboBox Button Style-->
    <Style x:Key="BookmarkComboBoxButtonStyle" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                          HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 右键菜单 -->
    <!--#region ListBoxItem右键菜单 -->
