<controls:BaseBookmarkWindow x:Class="ExplorerTabUtility.UI.Views.BookmarkManagePopup"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:language="clr-namespace:ExplorerTabUtility.Languages.Manager"
                             xmlns:behaviors="clr-namespace:ExplorerTabUtility.UI.Behaviors"
                             xmlns:controls="clr-namespace:ExplorerTabUtility.UI.Views.Controls"
                             xmlns:dd="urn:gong-wpf-dragdrop"
                             WindowStartupLocation="CenterScreen"
                             SizeToContent="Manual"
                             Style="{StaticResource BaseBookmarkWindowStyle}"
                             Width="1000" Height="800">
    <Border Style="{StaticResource BaseBookmarkWindowBorderStyle}">
        <Grid Margin="10 5 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource BookmarkTitleTextBlockStyle}"
                       Text="{Binding LanguageFields.BookmarkManageTitle,Source={x:Static language:LangeuageHelper.Instance}}"/>

            <Border Grid.Row="0" Grid.Column="2" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock x:Name="BtnMenu" Text="…" Style="{StaticResource BookmarkManageMenuTextBlockStyle}">
                    <TextBlock.ContextMenu>
                        <ContextMenu Placement="Left" HorizontalOffset="24">
                            <MenuItem x:Name="MenuImport" Style="{StaticResource TextBoxContextMenuItemStyle}" InputGestureText="Ctrl+I"
                                      Header="{Binding LanguageFields.ImportBookmark,Source={x:Static language:LangeuageHelper.Instance}}"/>
                            <MenuItem x:Name="MenuExport" Style="{StaticResource TextBoxContextMenuItemStyle}" InputGestureText="Ctrl+E"
                                      Header="{Binding LanguageFields.ExportBookmark,Source={x:Static language:LangeuageHelper.Instance}}"/>
                            <MenuItem x:Name="MenuSaveAndExport" Style="{StaticResource TextBoxContextMenuItemStyle}" InputGestureText="Ctrl+Shift+E"
                                      Header="{Binding LanguageFields.SaveAndExportBookmark,Source={x:Static language:LangeuageHelper.Instance}}"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </Border>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BookmarkTextBlockStyle}"
                       Text="{Binding LanguageFields.BookmarkFolderHeader,Source={x:Static language:LangeuageHelper.Instance}}"/>

            <TextBox x:Name="TxtSearch" Grid.Row="1" Grid.Column="2" Style="{StaticResource BookmarkSearchTextBoxStyle}"
                     Tag="{Binding LanguageFields.SearchBookmark,Source={x:Static language:LangeuageHelper.Instance}}"/>

            <controls:BookmarkTreeView x:Name="TvFolder" Grid.Row="2" Grid.Column="0" Style="{StaticResource BookmarkTreeViewStyle}"
                                       behaviors:TreeViewHelper.HaveExtraMenu="True"
                                       behaviors:TreeViewHelper.EnableRightClickSelection="True"
                                       dd:DragDrop.IsDropTarget="True"
                                       dd:DragDrop.IsDragSource="True"/>

            <ListBox x:Name="LbChildren" Grid.Row="2" Grid.Column="2" Style="{StaticResource BookmarkListBoxStyle}"
                     dd:DragDrop.IsDropTarget="True"
                     dd:DragDrop.IsDragSource="True"/>

            <StackPanel Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left">
                <Button x:Name="BtnNewFolder" Style="{StaticResource BookmarkButtonStyle}" ToolTip="Ctrl+N" Width="110"
                        Content="{Binding LanguageFields.NewFolder,Source={x:Static language:LangeuageHelper.Instance}}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Style="{StaticResource BookmarkButtonStyle}" ToolTip="Ctrl+S"
                        Content="{Binding LanguageFields.Save,Source={x:Static language:LangeuageHelper.Instance}}"/>
                <Button x:Name="BtnCancel" Style="{StaticResource BookmarkButtonStyle}" ToolTip="Esc"
                        Content="{Binding LanguageFields.Cancel,Source={x:Static language:LangeuageHelper.Instance}}"/>
            </StackPanel>
        </Grid>
    </Border>
</controls:BaseBookmarkWindow>
